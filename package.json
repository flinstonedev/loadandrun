{
  "name": "load-and-run",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "npm run demo",
    "demo": "npm run build && node scripts/demo.mjs",
    "dev:worker": "npm run build && wrangler dev --env local --local --ip 127.0.0.1 --port 4173",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "types": "wrangler types --strict-vars=false"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260918.0-alpha",
    "typescript": "^7.0.2",
    "wrangler": "^4.135.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@workos-inc/node": "^10.13.0",
    "jose": "^6.2.11"
  }
}
